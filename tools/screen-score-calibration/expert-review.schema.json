{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screen Score expert review responses",
  "type": "object",
  "required": ["reviewer_id", "protocol_version", "condition", "responses"],
  "properties": {
    "reviewer_id": { "pattern": "^EXP-[0-9]{3}$" },
    "protocol_version": { "const": "expert-study-v1" },
    "condition": { "enum": ["SCREEN_ONLY", "SCREEN_PLUS_FINDINGS"] },
    "review_order_seed": { "type": "string" },
    "primary_role": { "type": "string" },
    "years_experience_band": { "enum": ["<2", "2-5", "6-10", "10+"] },
    "ux_writing_specialist": { "type": "boolean" },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screen_id", "review_order", "block", "numeric_quality", "categorical_status", "weakest_risk_present", "confidence"],
        "properties": {
          "screen_id": { "pattern": "^SCR-[0-9]{3}$" },
          "review_order": { "type": "integer", "minimum": 1 },
          "block": { "type": "integer", "minimum": 1 },
          "numeric_quality": { "type": "number", "minimum": 0, "maximum": 100 },
          "categorical_status": { "enum": ["Buen nivel", "Necesita atención", "Requiere revisión"] },
          "weakest_risk_present": { "type": "boolean" },
          "weakest_risk_note": { "type": "string" },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "rationale": { "type": "string" },
          "response_complete": { "type": "boolean" }
        }
      }
    }
  }
}