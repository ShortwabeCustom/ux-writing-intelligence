{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screen Score calibration corpus",
  "type": "object",
  "required": ["corpus_version", "screens"],
  "properties": {
    "corpus_version": { "const": "screen-score-calibration-exploratory-v1" },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screen_id", "corpus_version", "primary_archetype", "ready_count", "contextual_scores", "audit_state", "privacy_status"],
        "properties": {
          "screen_id": { "pattern": "^SCR-[0-9]{3}$" },
          "corpus_version": { "const": "screen-score-calibration-exploratory-v1" },
          "primary_archetype": { "type": "string" },
          "ready_count": { "type": "integer", "minimum": 0 },
          "contextual_scores": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "audit_state": { "const": "current_complete" },
          "privacy_status": { "enum": ["SAFE", "REDACTION_REQUIRED", "EXCLUDE"] },
          "analyzed_success_count": { "type": "integer", "minimum": 1 },
          "audit_complete": { "const": true },
          "audit_current": { "const": true },
          "principal_risk_index": { "type": "integer", "minimum": 0 },
          "score_distribution": { "type": "object" },
          "n_stratum": { "enum": ["small", "medium", "large", "very_large"] },
          "worst_score_stratum": { "enum": ["0-20", "21-40", "41-60", "61-80", "81-100"] },
          "scoring_contract_version": { "type": "string" },
          "source_provenance_summary": { "type": "string" },
          "possible_duplicate": { "const": true },
          "principal_risk": {
            "type": "object",
            "properties": {
              "score": { "type": "number", "minimum": 0, "maximum": 100 },
              "severity": { "enum": ["low", "medium", "high"] }
            }
          },
          "expert": {
            "type": "object",
            "properties": {
              "numeric_ratings": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 100 } },
              "status_votes": { "type": "array", "items": { "enum": ["Buen nivel", "Necesita atención", "Requiere revisión"] } },
              "confidence": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 5 } },
              "adjudicated_status": { "enum": ["Buen nivel", "Necesita atención", "Requiere revisión"] },
              "disagreement_flag": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
